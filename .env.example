# Required environment variables
JWT_SECRET=
DOMAIN=localhost
RATELIMIT_KEY=


# Development database credentials (required by the application)
DEV_MYSQL_HOST=localhost
DEV_MYSQL_USERNAME=aime
DEV_MYSQL_PASSWORD=aime
DEV_MYSQL_DATABASE=aime

# Production database credentials (required by the application)
PROD_MYSQL_HOST=localhost
PROD_MYSQL_USERNAME=aime
PROD_MYSQL_PASSWORD=aime
PROD_MYSQL_DATABASE=aime

# Additional configuration
CLIENT_PORT=3000
SERVER_PORT=3001

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# CDN Configuration
CDN_URL=

# Party / Multiplayer (Artemis integration)
# ARTEMIS_BASE_URL is the root of the Artemis HTTP server — cozynet proxies
# /api/party/* to /internal/party/* under this base.
ARTEMIS_BASE_URL=

# ARTEMIS_WS_URL is the vite-dev proxy target for /ws/party. Leave empty to
# fall back to ARTEMIS_BASE_URL. Override only if WS needs a different host.
ARTEMIS_WS_URL=

# Shared server-to-server secret: cozynet presents it as X-Cozynet-Api-Key on
# every /internal/party/* call. Artemis rejects mismatches. MUST match the
# COZYNET_API_KEY env in Artemis's container.
COZYNET_API_KEY=

# Shared JWT signing secret for the short-lived realtime-token cozynet mints
# for browser WSS connections. MUST match LOBBY_SECRET in Artemis's container.
LOBBY_SECRET=
